generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model Profile {
  id         String         @id
  username   String?
  createdAt  DateTime       @default(now())
  journals   JournalEntry[]
  strategies Strategy[]
  trades     Trade[]

  @@schema("public")
}

model Trade {
  id     String @id @default(uuid())
  userId String

  symbol    String
  market    String? // Forex, Crypto, Stocks, Futures...
  timeframe String? // M1, M5, H1, H4...
  session   String? // Asia, London, New York

  direction TradeDirection
  entryType EntryType? // MARKET, LIMIT, STOP, STOP_LIMIT

  entryPrice Float
  exitPrice  Float?

  stopLoss   Float
  takeProfit Float?

  quantity   Float
  riskAmount Float?

  profitLoss Float?
  riskReward Float?

  status TradeStatus @default(OPEN)

  entryDate DateTime  @default(now())
  exitDate  DateTime?

  notes String?

  strategyId String?
  strategy   Strategy? @relation(fields: [strategyId], references: [id])

  discipline_rating Int?
  execution_rating  Int?
  emotions          String[] @default([])

  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id])

  remainingQuantity Float?

  screenshots TradeScreenshot[]

  partials TradePartial[]

  @@schema("public")
}

model TradePartial {
  id String @id @default(cuid())

  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  quantity          Float
  remainingQuantity Float

  exitPrice  Float
  profitLoss Float

  exitDate DateTime @default(now())

  createdAt DateTime @default(now())

  @@schema("public")
}

model Strategy {
  id          String  @id @default(cuid())
  name        String
  description String?

  userId String
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  trades Trade[]

  createdAt DateTime @default(now())

  @@schema("public")
}

model JournalEntry {
  id      String   @id @default(uuid())
  userId  String
  title   String
  content String
  date    DateTime @default(now())
  user    Profile  @relation(fields: [userId], references: [id])

  @@schema("public")
}

enum TradeDirection {
  LONG
  SHORT

  @@schema("public")
}

enum TradeStatus {
  OPEN
  WIN
  LOSS
  BREAKEVEN
  CLOSED

  @@schema("public")
}

enum Market {
  FOREX
  CRYPTO
  STOCKS
  INDICES
  FUTURES

  @@schema("public")
}

enum Session {
  ASIA
  LONDON
  NEW_YORK
  OVERLAP

  @@schema("public")
}

enum EntryType {
  FLIP
  BREAK_CURRENT_HL
  BREAK_PREVIOUS_HL

  @@schema("public")
}

model TradeScreenshot {
  id String @id @default(cuid())

  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  phase     ScreenshotPhase?
  timeframe String?

  url String

  createdAt DateTime @default(now())

  @@schema("public")
}

enum ScreenshotPhase {
  ENTRY
  EXIT

  @@schema("public")
}
